# Lead rate limiting: keep 'upstash' unless Vercel Firewall rules are configured and verified.
# Set to 'infrastructure' only after enabling a rate-limit rule for POST /api/leads in Vercel.
LEADS_RATE_LIMIT_MODE=upstash

# Private server-side credential. Never expose it with NEXT_PUBLIC_.
HUBSPOT_ACCESS_TOKEN=

# Public measurement identifiers. Configure only after consent and QA are implemented.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# International WhatsApp Business number, digits only (no +, spaces or punctuation).
NEXT_PUBLIC_WHATSAPP_BUSINESS_NUMBER=

# Canonical production URL (SEO metadata is pinned to this production domain).
NEXT_PUBLIC_SITE_URL=https://cotizatuseguro.com.ar
